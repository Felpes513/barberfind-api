# =============================
# BarberFind API - Environment
# =============================

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database (PostgreSQL)
# Para rodar a API via Maven usando o banco no Docker, mantenha localhost.
# Quando a API roda dentro do docker-compose, o docker-compose.yml sobrescreve para DB_HOST=db.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=barberdb
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# JPA / Hibernate
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Swagger / OpenAPI
SWAGGER_ENABLED=true

# Security (JWT)
JWT_SECRET=your_jwt_secret_with_at_least_32_characters
JWT_EXPIRATION_MS=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006
