# =============================
# BarberFind API - Environment
# =============================

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=barberdb
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# JPA / Hibernate
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Swagger / OpenAPI
SWAGGER_ENABLED=true

# Security (JWT)
JWT_SECRET=your_jwt_secret_with_at_least_32_characters
JWT_EXPIRES_MINUTES=60

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006